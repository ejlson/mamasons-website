/* The public site at mamasonsdirtyicecream.com: Cloudflare's Workers Builds runs `npm run build`
   on every push to main and uploads dist/ as static assets. No Worker code runs in front of it.
   The password-protected preview is a separate Worker: wrangler.preview.jsonc. */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mamasons-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    // a missing page gets a real 404, not the home page under a wrong address
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
